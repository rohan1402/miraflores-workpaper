{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workpaper",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["workpaper.api:app", "--app-dir", "backend", "--port", "8000", "--reload", "--reload-dir", "backend", "--timeout-graceful-shutdown", "3"],
